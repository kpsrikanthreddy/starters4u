{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/prerender.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "prerender": "tsx scripts/prerender.ts",
    "test": "tsx scripts/verify-seo.ts && tsx scripts/test-location-coordinates.ts && tsx scripts/test-order-tracking.ts && tsx scripts/test-payment-safety.ts && tsx scripts/test-menu-integration.ts",
    "test:seo": "tsx scripts/verify-seo.ts",
    "test:hardening": "tsx scripts/test-hardening.ts",
    "test:location": "tsx scripts/test-location-coordinates.ts",
    "test:tracking": "tsx scripts/test-order-tracking.ts",
    "test:pairing": "tsx scripts/test-print-devices-pairing.ts",
    "test:payment": "tsx scripts/test-payment-safety.ts",
    "test:phase1": "tsx scripts/test-phase1-multitenant.ts",
    "test:phase2": "tsx scripts/test-phase2-platform-onboarding.ts",
    "test:menu": "tsx scripts/test-menu-integration.ts",
    "test:bulk-menu": "tsx scripts/test-bulk-menu-import.ts",
    "test:phase5": "tsx scripts/test-phase5-order-channels.ts",
    "test:phase6": "tsx scripts/test-phase6-payments.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "@vis.gl/react-google-maps": "^1.10.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
